{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ci",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "LOADMASTER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "unix-debug",
      "hidden": true,
      "inherits": "ci",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "unix-release",
      "hidden": true,
      "inherits": "ci",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "unix-tsan",
      "hidden": true,
      "inherits": "ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "ci",
      "cacheVariables": { "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0" }
    },
    {
      "name": "macos-arm64-base",
      "hidden": true,
      "inherits": "macos-base",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" }
    },
    {
      "name": "macos-x86_64-base",
      "hidden": true,
      "inherits": "macos-base",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64" }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "ci",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "debug",
      "displayName": "Debug (Linux/macOS, host arch)",
      "inherits": "unix-debug"
    },
    {
      "name": "release",
      "displayName": "Release (Linux/macOS, host arch)",
      "inherits": "unix-release"
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer (Linux/macOS, host arch)",
      "inherits": "unix-tsan"
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS arm64 Debug",
      "inherits": "macos-arm64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64 Release",
      "inherits": "macos-arm64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-x86_64-debug",
      "displayName": "macOS x86_64 Debug",
      "inherits": "macos-x86_64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos-x86_64-release",
      "displayName": "macOS x86_64 Release",
      "inherits": "macos-x86_64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug" },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release" },
    { "name": "macos-x86_64-debug", "configurePreset": "macos-x86_64-debug" },
    { "name": "macos-x86_64-release", "configurePreset": "macos-x86_64-release" },
    { "name": "windows-debug", "configurePreset": "windows-debug", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "macos-x86_64-debug", "configurePreset": "macos-x86_64-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "macos-x86_64-release", "configurePreset": "macos-x86_64-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-debug", "configurePreset": "windows-debug", "configuration": "Debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
